-- Core MindSparQ Jarvis Relational Schema

CREATE TABLE project (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    slug TEXT NOT NULL UNIQUE,
    root_path TEXT NOT NULL,
    stack TEXT,
    template TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0,
    deleted_at INTEGER,
    settings_json TEXT
);

CREATE TABLE chat (
    id TEXT PRIMARY KEY NOT NULL,
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    agent TEXT NOT NULL,
    mode TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE message (
    id TEXT PRIMARY KEY NOT NULL,
    chat_id TEXT NOT NULL REFERENCES chat(id) ON DELETE CASCADE,
    role TEXT NOT NULL,
    content_json TEXT NOT NULL,
    model_ref TEXT,
    tokens_in INTEGER,
    tokens_out INTEGER,
    created_at INTEGER NOT NULL
);

CREATE TABLE task (
    id TEXT PRIMARY KEY NOT NULL,
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    chat_id TEXT REFERENCES chat(id) ON DELETE SET NULL,
    title TEXT NOT NULL,
    state TEXT NOT NULL,
    step INTEGER NOT NULL DEFAULT 0,
    repair_attempts INTEGER NOT NULL DEFAULT 0,
    budget_json TEXT,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    report_md TEXT
);

CREATE TABLE evidence (
    id TEXT PRIMARY KEY NOT NULL,
    task_id TEXT NOT NULL REFERENCES task(id) ON DELETE CASCADE,
    kind TEXT NOT NULL,
    summary TEXT NOT NULL,
    exit_code INTEGER,
    payload_path TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE checkpoint (
    id TEXT PRIMARY KEY NOT NULL,
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    task_id TEXT REFERENCES task(id) ON DELETE SET NULL,
    label TEXT NOT NULL,
    git_ref TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE provider (
    id TEXT PRIMARY KEY NOT NULL,
    kind TEXT NOT NULL,
    display_name TEXT NOT NULL,
    base_url TEXT NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    config_json TEXT
);

CREATE TABLE api_key (
    id TEXT PRIMARY KEY NOT NULL,
    provider_id TEXT NOT NULL REFERENCES provider(id) ON DELETE CASCADE,
    label TEXT NOT NULL,
    secret_ref TEXT NOT NULL,
    state TEXT NOT NULL DEFAULT 'HEALTHY',
    cooldown_until INTEGER,
    last_error TEXT,
    priority INTEGER NOT NULL DEFAULT 10,
    requests_today INTEGER NOT NULL DEFAULT 0,
    tokens_today INTEGER NOT NULL DEFAULT 0,
    last_used_at INTEGER
);

CREATE TABLE model (
    provider_id TEXT NOT NULL REFERENCES provider(id) ON DELETE CASCADE,
    model_id TEXT NOT NULL,
    display_name TEXT NOT NULL,
    context_length INTEGER NOT NULL DEFAULT 32000,
    supports_tools INTEGER NOT NULL DEFAULT 1,
    supports_vision INTEGER NOT NULL DEFAULT 0,
    supports_thinking INTEGER NOT NULL DEFAULT 0,
    is_free INTEGER NOT NULL DEFAULT 0,
    open_weights INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    last_seen_at INTEGER NOT NULL,
    pinned INTEGER NOT NULL DEFAULT 0,
    hidden INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(provider_id, model_id)
);

CREATE TABLE route_profile (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    task_class TEXT NOT NULL,
    chain_json TEXT NOT NULL,
    is_default INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE usage_daily (
    day TEXT NOT NULL,
    provider_id TEXT NOT NULL,
    model_id TEXT NOT NULL,
    key_id TEXT NOT NULL,
    requests INTEGER NOT NULL DEFAULT 0,
    tokens_in INTEGER NOT NULL DEFAULT 0,
    tokens_out INTEGER NOT NULL DEFAULT 0,
    cost_usd REAL NOT NULL DEFAULT 0.0,
    PRIMARY KEY(day, provider_id, model_id, key_id)
);

CREATE TABLE mcp_server (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    transport TEXT NOT NULL,
    command_json TEXT,
    url TEXT,
    env_refs_json TEXT,
    scope TEXT NOT NULL DEFAULT 'GLOBAL',
    project_id TEXT REFERENCES project(id) ON DELETE CASCADE,
    enabled INTEGER NOT NULL DEFAULT 1,
    source TEXT NOT NULL DEFAULT 'CUSTOM',
    created_at INTEGER NOT NULL
);

CREATE TABLE mcp_tool_permission (
    server_id TEXT NOT NULL REFERENCES mcp_server(id) ON DELETE CASCADE,
    tool_name TEXT NOT NULL,
    policy TEXT NOT NULL DEFAULT 'ASK',
    PRIMARY KEY(server_id, tool_name)
);

CREATE TABLE skill (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL UNIQUE,
    description TEXT NOT NULL,
    source_url TEXT,
    version TEXT,
    path TEXT NOT NULL,
    scope TEXT NOT NULL DEFAULT 'GLOBAL',
    has_scripts INTEGER NOT NULL DEFAULT 0,
    reviewed INTEGER NOT NULL DEFAULT 0,
    installed_at INTEGER NOT NULL
);

CREATE TABLE memory_item (
    id TEXT PRIMARY KEY NOT NULL,
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    kind TEXT NOT NULL,
    content TEXT NOT NULL,
    source TEXT,
    pinned INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE policy_rule (
    id TEXT PRIMARY KEY NOT NULL,
    scope TEXT NOT NULL DEFAULT 'GLOBAL',
    project_id TEXT REFERENCES project(id) ON DELETE CASCADE,
    kind TEXT NOT NULL,
    pattern TEXT NOT NULL,
    action TEXT NOT NULL
);

CREATE TABLE audit_event (
    id TEXT PRIMARY KEY NOT NULL,
    ts INTEGER NOT NULL,
    actor TEXT NOT NULL,
    action TEXT NOT NULL,
    target TEXT NOT NULL,
    outcome TEXT NOT NULL,
    detail_json TEXT
);

-- Queries: Project
selectAllProjects:
SELECT * FROM project WHERE archived = 0 AND deleted_at IS NULL ORDER BY updated_at DESC;

selectProjectById:
SELECT * FROM project WHERE id = ? LIMIT 1;

insertProject:
INSERT OR REPLACE INTO project (id, name, slug, root_path, stack, template, created_at, updated_at, archived, deleted_at, settings_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteProjectPermanently:
DELETE FROM project WHERE id = ?;

-- Queries: Chat
selectChatsForProject:
SELECT * FROM chat WHERE project_id = ? ORDER BY updated_at DESC;

insertChat:
INSERT OR REPLACE INTO chat (id, project_id, title, agent, mode, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Queries: Message
selectMessagesForChat:
SELECT * FROM message WHERE chat_id = ? ORDER BY created_at ASC;

insertMessage:
INSERT INTO message (id, chat_id, role, content_json, model_ref, tokens_in, tokens_out, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Queries: Task & Evidence
selectTasksForProject:
SELECT * FROM task WHERE project_id = ? ORDER BY started_at DESC;

insertTask:
INSERT OR REPLACE INTO task (id, project_id, chat_id, title, state, step, repair_attempts, budget_json, started_at, ended_at, report_md)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectEvidenceForTask:
SELECT * FROM evidence WHERE task_id = ? ORDER BY created_at ASC;

insertEvidence:
INSERT INTO evidence (id, task_id, kind, summary, exit_code, payload_path, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Queries: Providers & Keys
selectAllProviders:
SELECT * FROM provider WHERE enabled = 1;

upsertProvider:
INSERT OR REPLACE INTO provider (id, kind, display_name, base_url, enabled, config_json)
VALUES (?, ?, ?, ?, ?, ?);

selectKeysForProvider:
SELECT * FROM api_key WHERE provider_id = ? ORDER BY priority ASC, last_used_at ASC;

updateKeyCooldown:
UPDATE api_key SET state = ?, cooldown_until = ?, last_error = ? WHERE id = ?;

-- Queries: Models
selectAllModels:
SELECT * FROM model WHERE hidden = 0 ORDER BY pinned DESC, is_free DESC, context_length DESC;

selectModelsForProvider:
SELECT * FROM model WHERE provider_id = ? AND hidden = 0 ORDER BY pinned DESC, is_free DESC, context_length DESC;

selectFreeModels:
SELECT * FROM model WHERE is_free = 1 AND hidden = 0 ORDER BY context_length DESC;

upsertModel:
INSERT OR REPLACE INTO model (provider_id, model_id, display_name, context_length, supports_tools, supports_vision, supports_thinking, is_free, open_weights, created_at, last_seen_at, pinned, hidden)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

